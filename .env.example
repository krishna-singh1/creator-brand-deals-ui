# Copy to .env.local for development. Set these in your host (Vercel/Railway) for each environment.
#
# Option A (default, ADR 0008): the browser calls the API directly. Web and API must share a parent domain in prod
# (app.<domain> / api.<domain>), and the API must allow this app's origin in CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
#
# Option B: same-origin proxy, for hosts without a shared parent domain (e.g. two *.up.railway.app services).
# This app forwards /api/v1/* to API_ORIGIN, so sign-in cookies are first-party. Leave the API's COOKIE_DOMAIN unset.
# API_ORIGIN=https://creator-brand-deals-production.up.railway.app
# NEXT_PUBLIC_API_URL=/api/v1
#
# Both are read at build time: redeploy after changing them.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
#
# Product analytics (PostHog, D-38). Empty = off, so dev and e2e send nothing.
# Browser-only events (page views, landing CTA clicks, sign-up started); business numbers come from the API's
# /admin/insights instead. Read at build time.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://eu.i.posthog.com when unset.
# NEXT_PUBLIC_POSTHOG_HOST=
